{
    "name": "React Chrome Extension",
    "manifest_version": 3,
    "version": "1.0.0",
    "description": "A simple React app as a Chrome extension",
    "action": {
        "default_popup": "index.html"
    },
    "host_permissions": [
      "<all_urls>",
      "https://localhost:8000/*"
    ],
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "type": "module"
    }
  ]
}